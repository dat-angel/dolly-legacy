{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dat-angel/dolly-legacy/moments.schema.json",
  "title": "Dolly Legacy Moments Database",
  "description": "Schema for the open CC BY 4.0 moments database documenting Dolly Parton's legacy.",
  "type": "object",
  "required": ["meta", "moments"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["name", "version", "license", "attribution"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "description": { "type": "string" },
        "license": { "const": "CC-BY-4.0" },
        "licenseUrl": { "type": "string", "format": "uri" },
        "attribution": { "type": "string" },
        "repository": { "type": "string", "format": "uri" },
        "schema": { "type": "string" },
        "thirdPartyNotice": { "type": "string" }
      },
      "additionalProperties": false
    },
    "moments": {
      "type": "array",
      "items": { "$ref": "#/$defs/moment" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mood": {
      "type": "string",
      "enum": ["laugh", "courage", "facts", "surprise"]
    },
    "category": {
      "type": "string",
      "enum": ["music", "lyrics", "philanthropy", "advocacy", "career", "personal"]
    },
    "era": {
      "type": "string",
      "enum": ["1950s", "1960s", "1970s", "1980s", "1990s", "2000s", "2010s", "2020s"]
    },
    "chapter": {
      "type": "string",
      "enum": ["origins", "music", "building", "giving", "standing"]
    },
    "moment": {
      "type": "object",
      "required": ["id", "title", "era", "category", "tags", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable URL-safe identifier"
        },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "era": { "$ref": "#/$defs/era" },
        "category": { "$ref": "#/$defs/category" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "hiddenFact": { "type": "string" },
        "quote": { "type": "string" },
        "source": { "type": "string", "format": "uri" },
        "featured": { "type": "boolean" },
        "chapter": { "$ref": "#/$defs/chapter" },
        "relatedIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "moodTags": {
          "type": "array",
          "items": { "$ref": "#/$defs/mood" }
        },
        "dollySayKeywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  }
}
